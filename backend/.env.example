# Copy this file to .env and fill in your real values from the Supabase dashboard
# (Project Settings -> API). Never commit the .env file.

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Auth — used to sign login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=8h

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only key that bypasses Row Level Security. Keep it secret; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayMongo (GCash payment gateway). Test-mode keys from the PayMongo dashboard.
# The SECRET key is server-only — never log it or send it to the frontend.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
