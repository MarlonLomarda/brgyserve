# Copy this file to .env and fill in your real values from the Supabase dashboard
# (Project Settings -> API). Never commit the .env file.

# Server
PORT=5000

# SMS delivery mode.
#   SIMULATED (default) — messages are composed and recorded in the
#     notifications table but NOT sent. No provider, no API key, no HTTP call.
#   SEMAPHORE — real sending. Not implemented yet; see the adapter seam in
#     src/services/notifications.js. Setting it before that is written just
#     records every notification as FAILED.
# Unset behaves as SIMULATED, so a missing value can never send anything.
SMS_MODE=SIMULATED

# EMAIL delivery mode. SEPARATE FROM SMS_MODE ON PURPOSE — the two types are at
# different stages and a single setting would mean the decision for one is the
# decision for the other. SMS_MODE=SEMAPHORE must never route a password reset
# email, and EMAIL_MODE=RESEND must never claim an SMS was sent.
#   SIMULATED (default) — composed and recorded, nothing sent.
#   RESEND — real sending, through the Resend API. This is the ONLY thing in
#     the project that actually sends anything.
# Unset behaves as SIMULATED, the same rule as SMS_MODE.
EMAIL_MODE=SIMULATED

# Resend (password reset emails). Read ONLY by src/services/resend.js.
#
# A MISSING KEY DOES NOT STOP THE API BOOTING, and that is deliberate. Compare
# SUPABASE_SERVICE_ROLE_KEY below, which is checked at startup because EVERY
# query depends on it and its absence fails SILENTLY — the server answers
# /api/health and then returns an empty result set for everything, so a login
# reads as "invalid credentials". Neither is true here: RESEND_API_KEY is used
# by one feature, and its absence is loud and local (a FAILED notification row
# naming the reason, visible on /secretary/notifications). Refusing to boot
# over it would take document requests, payments, attendance, reports and login
# down for a password-reset misconfiguration, which is strictly worse than the
# one broken feature. It also matches how PAYMONGO_SECRET_KEY is treated.
#
# RESEND_FROM is the sender, e.g. "BrgyServe <onboarding@resend.dev>".
# onboarding@resend.dev is Resend's shared sandbox address: it needs no DNS
# setup and in exchange it ONLY delivers to the email address that owns the
# Resend account. Every other recipient is accepted by the API and dropped.
# That is the sender, not a bug — verify a domain to lift it.
RESEND_API_KEY=
RESEND_FROM=BrgyServe <onboarding@resend.dev>

# Browser origins allowed to call this API (CORS). Comma-separated; normally
# just one. Add a second TEMPORARILY to test from another device on the LAN —
# e.g. a phone hitting the dev server — and remove it afterwards:
#   FRONTEND_URL=http://localhost:5173,http://192.168.1.14:5173
# Never use "*": this list is the only thing naming who may call the API.
FRONTEND_URL=http://localhost:5173

# The SINGLE origin residents are sent to: the GCash return page, and the
# password reset link in the email (utils/frontendOrigin.js serves both).
# Separate from FRONTEND_URL because that one is a LIST: with two entries in it,
# the redirect became ".../localhost:5173,http://192.168.1.14:5173/resident/...".
# Leave it blank and the first entry of FRONTEND_URL is used, which is correct
# in local dev. Set it explicitly in production — no trailing slash. A wrong
# value here produces a reset link nobody can follow.
#   PUBLIC_FRONTEND_URL=https://brgyserve.vercel.app
# Mnemonic: PUBLIC_BASE_URL is where PayMongo reaches US; PUBLIC_FRONTEND_URL
# is where we send RESIDENTS back.
PUBLIC_FRONTEND_URL=

# Auth — used to sign login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=8h

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED. Server-only key that bypasses Row Level Security — keep it secret and
# never expose it to the frontend. The API refuses to start without it: RLS is
# enabled on every table with no policies written, so any other key reads nothing
# and every query would come back empty instead of failing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NOT read by the backend — kept here only so its absence is not mistaken for an
# oversight. It is the browser-safe key, and nothing in this API uses it; the
# frontend talks to this API rather than to Supabase directly.
SUPABASE_ANON_KEY=your-anon-key

# PayMongo (GCash payment gateway). Test-mode keys from the PayMongo dashboard.
# The SECRET key is server-only — never log it or send it to the frontend.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Public HTTPS origin PayMongo calls back on. In development this is filled in
# automatically by `npm run tunnel` (a cloudflared quick tunnel); in production
# set it to the deployed API origin and run `npm run tunnel:sync` once.
# Never hardcode a hostname anywhere else.
PUBLIC_BASE_URL=

# The single PayMongo webhook, managed by scripts/paymongoWebhook.js. Both are
# written automatically — do not edit by hand.
#   _ID     the webhook to update in place when the tunnel url changes
#   _SECRET the HMAC key for verifying the Paymongo-Signature header. This is
#           the WEBHOOK's own secret, NOT PAYMONGO_SECRET_KEY. Server-only.
PAYMONGO_WEBHOOK_ID=
PAYMONGO_WEBHOOK_SECRET=
