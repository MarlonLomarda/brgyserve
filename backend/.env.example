# Copy this file to .env and fill in your real values from the Supabase dashboard
# (Project Settings -> API). Never commit the .env file.

# Server
PORT=5000

# Notification delivery mode.
#   SIMULATED (default) — messages are composed and recorded in the
#     notifications table but NOT sent. No provider, no API key, no HTTP call.
#   SEMAPHORE — real sending. Not implemented yet; see the adapter seam in
#     src/services/notifications.js. Setting it before that is written just
#     records every notification as FAILED.
# Unset behaves as SIMULATED, so a missing value can never send anything.
SMS_MODE=SIMULATED

# Browser origins allowed to call this API (CORS). Comma-separated; normally
# just one. Add a second TEMPORARILY to test from another device on the LAN —
# e.g. a phone hitting the dev server — and remove it afterwards:
#   FRONTEND_URL=http://localhost:5173,http://192.168.1.14:5173
# Never use "*": this list is the only thing naming who may call the API.
FRONTEND_URL=http://localhost:5173

# Auth — used to sign login tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=8h

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only key that bypasses Row Level Security. Keep it secret; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayMongo (GCash payment gateway). Test-mode keys from the PayMongo dashboard.
# The SECRET key is server-only — never log it or send it to the frontend.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Public HTTPS origin PayMongo calls back on. In development this is filled in
# automatically by `npm run tunnel` (a cloudflared quick tunnel); in production
# set it to the deployed API origin and run `npm run tunnel:sync` once.
# Never hardcode a hostname anywhere else.
PUBLIC_BASE_URL=

# The single PayMongo webhook, managed by scripts/paymongoWebhook.js. Both are
# written automatically — do not edit by hand.
#   _ID     the webhook to update in place when the tunnel url changes
#   _SECRET the HMAC key for verifying the Paymongo-Signature header. This is
#           the WEBHOOK's own secret, NOT PAYMONGO_SECRET_KEY. Server-only.
PAYMONGO_WEBHOOK_ID=
PAYMONGO_WEBHOOK_SECRET=
