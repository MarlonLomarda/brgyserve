# Base URL of the BrgyServe backend API, including the /api suffix.
#
# REQUIRED FOR ANY BUILD. `npm run build` fails if this is unset (vite.config.js)
# rather than silently baking in localhost — a bundle pointing at localhost:5000
# deploys green and then fails every request in the browser.
#
# The dev server (`npm run dev`) falls back to http://localhost:5000/api, so
# this file is optional for local development and required only to build.
#
# Vercel: set VITE_API_URL in the project's Environment Variables, e.g.
#   VITE_API_URL=https://brgyserve-api.onrender.com/api
VITE_API_URL=http://localhost:3000/api
